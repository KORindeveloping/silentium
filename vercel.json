{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/books/(.*)",
      "destination": "https://silentium-m9z8.onrender.com/api/books/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://silentium-m9z8.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
