{
  "version": 2,
  "builds": [
    {
      "src": "api/books.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/health.ts", 
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.ts"
    },
    {
      "src": "/api/books",
      "dest": "/api/books.ts"
    },
    {
      "src": "/api/books/(.*)",
      "dest": "/api/books.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/books.ts": {
      "maxDuration": 30
    }
  }
}
